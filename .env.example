# Database — matches docker-compose.yml (host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL="postgresql://meetsnaply:meetsnaply@localhost:5433/meetsnaply?schema=public"

# Session signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Encrypts OAuth tokens at rest. Falls back to AUTH_SECRET if unset, but set a
# separate one in production — rotating your session key should not lock every
# connected calendar out. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=""

# Public origin. Must match the redirect URI registered with Google exactly.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Calendar ---------------------------------------------------------
# Google Cloud console → APIs & Services:
#   1. Enable the Google Calendar API.
#   2. OAuth consent screen: External, add the calendar.events,
#      calendar.readonly and userinfo.email scopes. While the app is in
#      "Testing", add yourself under Test users or the grant expires weekly.
#   3. Credentials → OAuth client ID → Web application, with the redirect URI:
#      http://localhost:3000/api/calendar/google/callback
# Leave these empty and the app runs fine — the calendar UI just shows as
# unconfigured and conflicts are checked against meetsnaply bookings only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Recap pipeline -----------------------------------------------------------
# Every key below is optional. With none set the app runs normally: meetings use
# a local placeholder room, nothing is recorded, and the pipeline stays idle.
# Each stage checks its own key and dead-letters with a clear reason if missing.

# Video rooms + cloud recording (https://dashboard.daily.co)
# Point the "recording.ready-to-download" webhook at:
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/daily
DAILY_API_KEY=""
DAILY_WEBHOOK_SECRET=""

# Speaker-diarized transcription (https://console.deepgram.com)
DEEPGRAM_API_KEY=""

# Recap generation. Uses claude-opus-5.
ANTHROPIC_API_KEY=""

# Transactional email (https://resend.com). Powers booking confirmations,
# reminders, and recaps. Without it every send is logged instead, and the job
# completes without marking anyone as delivered.
RESEND_API_KEY=""
EMAIL_FROM="meetsnaply <recaps@yourdomain.com>"

# Shared secret for POST /api/jobs/run, the queue's HTTP trigger. Required —
# the endpoint refuses every request when unset. Not needed if you run
# `npm run worker` instead. Generate with:  openssl rand -base64 32
JOBS_RUN_SECRET=""
